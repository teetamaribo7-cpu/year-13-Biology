<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StLouis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/school_primary</item>
        <item name="colorPrimaryVariant">@color/school_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/school_accent</item>
        <item name="android:statusBarColor">@color/school_primary</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>

    <!-- Big subject buttons -->
    <style name="SubjectButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Strand buttons (two lines of text) -->
    <style name="StrandButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Small quiz buttons (three in a row) -->
    <style name="QuizButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Tool buttons at the bottom -->
    <style name="ToolButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/text_soft</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="SmallLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_soft</item>
    </style>
</resources>
